# Chon bo du bao: local_onnx hoac remote_http
FORECAST_PROVIDER=local_onnx

# Can dung khi FORECAST_PROVIDER=remote_http. HTTPS bat buoc voi host tu xa; HTTP chi cho localhost.
FORECAST_API_URL=
FORECAST_API_KEY=
FORECAST_API_TIMEOUT_SECONDS=8
# Only for a protected deployment with authentication/rate-limit/cost monitoring
FORECAST_API_PUBLIC_ENABLED=false

# Local demo only
PUBLIC_DEMO_MODE=false
AICC_VIDEO_ENABLED=true
AICC_SAMPLE_FPS=6

# Real interactive street map; default uses standard OpenStreetMap raster tiles. Internet required.
# Respect provider attribution and tile usage policy; for production/heavy traffic use a provider with an SLA.
MAP_BASE_NAME=OpenStreetMap
MAP_TILE_URL_TEMPLATE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a>
CAMERA_REFRESH_SECONDS=15

# Optional REAL traffic tile overlay. Leave empty until a provider and its rights are configured.
# Many providers require an API key; browser tile URLs are visible to the client, so use a restricted browser key only.
# Do NOT put server secrets in this URL. The system does not synthesize traffic colors when this is empty.
TRAFFIC_LAYER_NAME=Giao thông trực tiếp
TRAFFIC_TILE_URL_TEMPLATE=
TRAFFIC_TILE_ATTRIBUTION=

# Video frame evidence: detections sampled between 0.25 and 2 FPS on CPU.
VIDEO_REVIEW_SAMPLE_FPS=1.0

# Road-network alternatives (OSRM public demo provides static/reference duration, not live traffic).
ROUTING_API_BASE_URL=https://router.project-osrm.org
ROUTING_API_TIMEOUT_SECONDS=8
